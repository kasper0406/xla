// RUN: hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../../../backends/gpu/target_config/specs/b200.txtpb | FileCheck %s

// On datacenter Blackwell (B200, sm_100a, major=10): the consumer sm_120 FP8
// conv workaround must NOT apply. The convolution operands should remain FP8,
// not be widened to BF16.

// Verify f8e4m3fn conv is NOT widened:
// CHECK: f8e4m3fn
// CHECK: custom_call_target="__cudnn$convForward"
// Verify f8e5m2 conv is NOT widened:
// CHECK: f8e5m2
// CHECK: custom_call_target="__cudnn$convForward"
// No bf16 widening or graph conv fusion should occur:
// CHECK-NOT: bf16
// CHECK-NOT: __cudnn$convForwardGraph

HloModule F8DepthwiseConvNotWidenedOnB200

ENTRY main {
  input_e4m3 = f8e4m3fn[1,6,6,64]{3,2,1,0} parameter(0)
  filter_e4m3 = f8e4m3fn[3,3,1,64]{3,2,1,0} parameter(1)
  conv_e4m3 = f8e4m3fn[1,6,6,64]{3,2,1,0} convolution(input_e4m3, filter_e4m3),
    window={size=3x3 pad=1_1x1_1}, dim_labels=b01f_01io->b01f, feature_group_count=64

  input_e5m2 = f8e5m2[1,6,6,64]{3,2,1,0} parameter(2)
  filter_e5m2 = f8e5m2[3,3,1,64]{3,2,1,0} parameter(3)
  conv_e5m2 = f8e5m2[1,6,6,64]{3,2,1,0} convolution(input_e5m2, filter_e5m2),
    window={size=3x3 pad=1_1x1_1}, dim_labels=b01f_01io->b01f, feature_group_count=64

  ROOT tuple = (f8e4m3fn[1,6,6,64]{3,2,1,0}, f8e5m2[1,6,6,64]{3,2,1,0}) tuple(conv_e4m3, conv_e5m2)
}
