// RUN: hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../../../backends/gpu/target_config/specs/rtx6000pro.txtpb | FileCheck %s

// Blackwell consumer (sm_120, major=12) should compile regular FP8 convolutions
// (groups=1) successfully using the FP8 graph conv path. cuDNN supports FP8
// convolutions with channels_per_group >= 16 on sm_120.

// Regular FP8 conv (groups=1, C/groups=16 >= 16) goes through graph conv:
// CHECK: custom_call_target="__cudnn$convForwardGraph"

HloModule ConvCuDNN

ENTRY main {
  Arg_0.1 = f8e4m3fn[1,64,64,16]{3,2,1,0} parameter(0), sharding={replicated}
  Arg_1.2 = f8e4m3fn[3,3,16,32]{3,2,1,0} parameter(1), sharding={replicated}
  ROOT convolution.3 = f8e4m3fn[1,64,64,32]{3,2,1,0} convolution(Arg_0.1, Arg_1.2),
    window={size=3x3 pad=1_1x1_1}, dim_labels=b01f_01io->b01f
}
